# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = tab
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
spelling_language = en-US

[*.{py,pyi}]
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2
indent_style = space
